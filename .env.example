# ---------------------------------------------------------------------------
# SOMOS — variables de entorno
# Copia este archivo a `.env` y completa los valores reales.
# NUNCA versionar el `.env`.
# ---------------------------------------------------------------------------

# --- Base de datos -----------------------------------------------------------
# PostgreSQL corre FUERA de Docker (nativo en el host o en un servidor dedicado).
#
# Corriendo la app con `npm run dev` en el host:
DATABASE_URL="postgresql://somos_user:CAMBIAME@localhost:5432/somos_db?schema=public"
#
# Corriendo la app dentro de Docker contra un Postgres del host, usar:
# DATABASE_URL="postgresql://somos_user:CAMBIAME@host.docker.internal:5432/somos_db?schema=public"
#
# Si la contrasena tiene caracteres especiales (@ : / ? #) debe ir URL-encodeada.

# --- Sesiones ----------------------------------------------------------------
# Secreto para firmar los JWT del panel admin y de puerta.
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="CAMBIAME_POR_UN_SECRETO_LARGO_Y_ALEATORIO"

# --- Aplicacion --------------------------------------------------------------
# URL publica del sitio. De aqui salen el contenido de los QR y los links de los
# correos, asi que TIENE que coincidir con el puerto real donde corre la app.
# En desarrollo, `npm run dev` fija el puerto 3100 para no chocar con otros
# proyectos que suelen ocupar el 3000.
APP_URL="http://localhost:3100"

# Carpeta donde se guardan los comprobantes de transferencia subidos.
# En Docker se monta como volumen (ver docker-compose.yml).
UPLOADS_DIR="./data/comprobantes"

# Tamano maximo de comprobante aceptado, en megabytes.
UPLOAD_MAX_MB="8"

# --- Pago en linea (opcional) ------------------------------------------------
# Hay dos pasarelas implementadas y esta variable decide cual se usa:
#
#   PASARELA="fintoc"       transferencia bancaria, ~1% + IVA
#   PASARELA="mercadopago"  tarjetas de credito y debito, comision mas alta
#   PASARELA=""             ninguna: solo transferencia manual + comprobante
#
# Si la elegida no tiene sus credenciales cargadas, el sitio se queda con el
# flujo manual. No se autodetecta a proposito: dejar que el cobro dependa de
# que variables quedaron sueltas es una forma facil de cobrar por donde no era.
PASARELA=""

# --- Fintoc ------------------------------------------------------------------
# Llaves del Dashboard (dashboard.fintoc.com). Las de prueba son autoservicio.
# Hacen falta las DOS: la secreta crea la sesion de pago en el servidor y la
# publica monta el widget en el navegador. Con una sola, el pago no aparece.
FINTOC_SECRET_KEY=""
FINTOC_PUBLIC_KEY=""

# Secreto del endpoint de webhook. Sin esto el webhook rechaza todo lo que
# llegue: es lo unico que evita que cualquiera se invente un pago confirmado.
# Webhook a registrar:  <APP_URL>/api/webhooks/fintoc
# Eventos:              checkout_session.finished, checkout_session.expired
FINTOC_WEBHOOK_SECRET=""

# --- Mercado Pago ------------------------------------------------------------
# Credenciales de https://www.mercadopago.cl/developers/panel/app
# Igual que arriba: el access token cobra desde el servidor y la llave publica
# monta el formulario en el navegador.
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_PUBLIC_KEY=""

# Firma secreta del webhook, del mismo panel.
# Webhook a registrar:  <APP_URL>/api/webhooks/mercadopago
# Evento:               payment
MERCADOPAGO_WEBHOOK_SECRET=""

# Nota: no hace falta tunel para probar en local. El webhook es la via
# principal, pero la app tambien le pregunta a la pasarela por los cobros
# pendientes, asi que el flujo se cierra igual.

# --- Correo (Resend) ---------------------------------------------------------
# Deja EMAIL_ENABLED en "false" para desarrollar sin mandar correos:
# el contenido del mail se imprime en consola en vez de enviarse.
EMAIL_ENABLED="false"
RESEND_API_KEY=""
EMAIL_FROM="SOMOS <entradas@tudominio.cl>"

# --- Usuario administrador inicial (solo lo usa el seed) ---------------------
ADMIN_SEED_CORREO="admin@somos.cl"
ADMIN_SEED_NOMBRE="Administrador SOMOS"
ADMIN_SEED_PASSWORD="CAMBIAME123"

# ---------------------------------------------------------------------------
# Aviso de "sitio en desarrollo"
# ---------------------------------------------------------------------------
# Se muestra una franja arriba avisando que esto todavia no es definitivo.
# Ponlo en "off" el dia que el sitio quede publicado de verdad.
AVISO_DESARROLLO="on"
